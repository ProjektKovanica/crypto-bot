# Binance Futures API credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_api_secret_here

# Dashboard API key (for protecting /api routes)
API_KEY=your_dashboard_api_key_here

# Telegram bot (optional)
