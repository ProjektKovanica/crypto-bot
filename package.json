{
  "name": "crypto-bot",
  "version": "1.0.0",
  "description": "Automated cryptocurrency trading bot with Binance Futures integration",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "nodemon bot.js",
    "server": "node server.js",
    "free-margin": "node free-margin.js",
    "free-margin:dry": "node free-margin.js --dry-run",
    "diagnose": "node diagnose-balance.js",
    "test": "node test-balance.js && node test-position-mode.js",
    "enable-multi-assets": "node diagnose-balance.js --enable-multi-assets",
    "diagnose:summary": "node diagnose-balance.js --summary"
  },
  "keywords": [
    "crypto",
    "trading",
    "bot",
    "binance",
    "futures"
  ],
  "author": "ProjektKovanica",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^9.4.3",
    "ccxt": "^4.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "20.20.2"
  }
}